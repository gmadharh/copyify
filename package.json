{
  "name": "copyify",
  "version": "2.0.0",
  "description": "Browser extension to copy Spotify track info with one-click buttons",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "parcel watch --host localhost --config @parcel/config-webextension",
    "build": "parcel build --config @parcel/config-webextension"
  },
  "source": [
    "src/script.ts",
    "manifest.json"
  ],
  "@parcel/resolver-default": {
    "packageExports": true
  },
  "parcel-namer-hashless": {
    "include": [
      "script[.]js$"
    ],
    "exclude": [
      "icon[.]png$"
    ],
    "mode": "all"
  },
  "type": "module",
  "keywords": ["spotify", "chrome-extension", "firefox-addon", "copy", "track-info"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@parcel/config-webextension": "^2.11.0",
    "@types/chrome": "^0.0.258",
    "parcel": "^2.11.0",
    "parcel-namer-hashless": "^1.0.6",
    "parcel-reporter-clean-dist": "^1.0.4",
    "typescript": "^5.3.3"
  }
}
