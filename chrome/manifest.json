{
  "manifest_version": 3,
  "name": "Copyify",

  "version": "2.0",
  "description": "Easily copy and paste the song title, album, or artist directly from the Spotify track webpage with one-click copy buttons",
  "icons": {
    "128": "./src/assets/icon.png"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "host_permissions": [
    "http://open.spotify.com/track/*",
    "https://open.spotify.com/track/*"
  ],
  "permissions": ["scripting", "activeTab"]
}
